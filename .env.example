# 이 파일을 복사해서 .env.local 을 만들고 값을 채워 주세요.
#   cp .env.example .env.local
# 아래 값은 모두 브라우저에 공개되어도 괜찮은 값입니다. (API 키 같은 비밀 값은 넣지 않습니다)

# Appwrite 콘솔 > 프로젝트 > Settings 에 있는 API Endpoint
# 예: https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_ENDPOINT=

# Appwrite 콘솔 > 프로젝트 > Settings 에 있는 Project ID
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Appwrite 콘솔 > Databases 에서 만든 데이터베이스의 Database ID
NEXT_PUBLIC_APPWRITE_DATABASE_ID=

# 서버 전용 비밀 키 (테이블 설정 스크립트, 편지 열기, 카카오 로그인). NEXT_PUBLIC_을 붙이지 마세요.
# Appwrite 콘솔 > Overview > API Keys > Create API key (Databases 권한 전체 + Auth의 users.read, users.write)
APPWRITE_API_KEY=

# ── 카카오 로그인 (서버 전용, NEXT_PUBLIC_ 붙이지 않기) ──
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 카카오 개발자 콘솔 > 카카오 로그인 > 보안 > Client Secret 코드
KAKAO_CLIENT_SECRET=
# 로그인 도중 상태 쿠키 서명용 아무 긴 무작위 문자열 (예: openssl rand -base64 32)
AUTH_SECRET=
